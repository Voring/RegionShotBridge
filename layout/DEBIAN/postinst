#!/bin/sh
set -e

UICACHE=""
for p in /var/jb/usr/bin/uicache /usr/bin/uicache /var/jb/usr/bin/uicache.dpkg-dist; do
    if [ -x "$p" ]; then
        UICACHE="$p"
        break
    fi
done

if [ -n "$UICACHE" ]; then
    "$UICACHE" -a >/dev/null 2>&1 || true
else
    uicache -a >/dev/null 2>&1 || true
fi

exit 0
